# systemd 사용자 서비스. 설치:
#   mkdir -p ~/.config/systemd/user && cp user/deploy/ymath.service ~/.config/systemd/user/
#   npm run build:node
#   systemctl --user daemon-reload && systemctl --user enable --now ymath
#   loginctl enable-linger $USER      # 로그인하지 않아도 계속 실행
# 앞은 edge Caddy가 study.xcv.kr/math/* → 10.0.0.9:3141 로 연결한다.
[Unit]
Description=ymath — 수학 오답노트 (SvelteKit)
After=network.target

[Service]
WorkingDirectory=/opt/ymath
ExecStart=/usr/bin/node .build
Restart=on-failure
RestartSec=3
Environment=HOST=0.0.0.0
Environment=PORT=3141
# edge Caddy 가 X-Forwarded-Proto(https) 와 X-Forwarded-Host 를 보내므로 이를 신뢰한다
Environment=PROTOCOL_HEADER=x-forwarded-proto
Environment=HOST_HEADER=x-forwarded-host
# 정식 공개 출처 하나. guard 의 Origin 검사(sameOriginOk)가 이 주소만 정식 출처로 받아들이고,
# 어댑터의 폼 CSRF Origin 검사도 같은 값을 쓴다. 호스트를 바꾸면 여기만 고친다.
Environment=ORIGIN=https://study.xcv.kr
# ADDRESS_HEADER(x-forwarded-for 등)는 절대 설정하지 않는다. 어댑터가 소켓 주소 대신 그 헤더만
# 읽게 되어, 헤더가 없는 요청(내부망 직접 접속·루프백)에서 getClientAddress 가 예외로 실패한다.
#  → 감사 로그 ip=unknown 이 보이면 이 설정부터 의심할 것
# Restart=on-failure 로 자동 재기동되므로 중단은 빠를수록 좋다. 진행 중 분석은 record.json 을
# 보고 시작 시 큐에 다시 넣으니(recover) SIGTERM 뒤 오래 기다리지 않는다 — 기본 90s 동안
# 종료를 기다리면 그 창이 그대로 502 가 된다(2026-11-22 실측).
TimeoutStopSec=10
# 사진(수 MB)을 받아야 하므로 기본 512KB 제한을 늘린다
Environment=BODY_SIZE_LIMIT=30M
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
# 비밀이 필요한 값은 저장소에 넣지 않고 별도 파일에 둔다(chmod 600):
#   ~/.config/ymath.env  →  S3_*(사진 백업 5개)  STUDENT_NAME=...
EnvironmentFile=-%h/.config/ymath.env
# GLM 주소·API 키·모델은 user/config/providers.json 의 zai 항목 한 곳에서 관리한다(커밋 안 됨).
# 선택: Environment=DATA_DIR=%h/ymath-data   (기본 ./user/data)
# 선택: Environment=OCR_MODEL=glm-4.6v       (기본값과 동일 — providers.json 의 zai 주소·키를 쓴다)

[Install]
WantedBy=default.target
