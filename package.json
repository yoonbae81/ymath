{
	"name": "ymath",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/check-worker-bundle.mjs",
		"build:worker": "vite build && node scripts/check-worker-bundle.mjs",
		"build:node": "BUILD_TARGET=node vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:inngest:local": "RUN_INNGEST_REPORT_LOCAL=1 vitest --run src/lib/server/cloudflare/inngest-report.local.test.ts",
		"test:inngest:fixture": "RUN_INNGEST_REPORT_LOCAL=1 RUN_INNGEST_REPORT_FIXTURE=1 vitest --run src/lib/server/cloudflare/inngest-report.local.test.ts",
		"test:inngest:wrangler:local": "node --import tsx scripts/check-inngest-local.mjs",
		"test:migration": "node --test scripts/cloudflare-migrate.test.mjs scripts/cloudflare-migrate.integration.test.mjs",
		"audit": "npm audit --omit=dev",
		"start": "BODY_SIZE_LIMIT=30M node .build",
		"runner:cloudflare": "tsx src/lib/server/cloudflare/runner.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/katex": "^0.16.8",
		"@types/node": "^26.6.2",
		"esbuild": "^0.28.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"wrangler": "^4.151.1"
	},
	"dependencies": {
		"@cf-wasm/photon": "0.4.0",
		"@jsquash/jpeg": "1.6.0",
		"ajv": "^8.20.0",
		"aws4fetch": "^1.0.20",
		"exifr": "7.1.3",
		"image-size": "2.0.4",
		"inngest": "4.24.0",
		"katex": "^0.18.7",
		"sharp": "^0.35.4"
	}
}
